# Environment & secrets (CRITICAL)
.env
.env.*
!.env.example
*.local

# Dependencies & Environments
node_modules/
frontend/node_modules/
.venv/
venv/
env/

# Frontend Caches & Framework outputs
dist/
dist-ssr/
.tanstack/
frontend/

# Frontend & Package Manager Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright & Test Results
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

